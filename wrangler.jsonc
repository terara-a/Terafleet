{
  "name": "terafleet-poc",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-27",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "SETUP_DB",
      "database_name": "terafleet-setup",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
